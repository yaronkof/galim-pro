# Galim Pro / Ministry of Education credentials
GALIM_USERNAME=
GALIM_PASSWORD=

# Home Assistant's MQTT broker (Mosquitto)
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Optional settings
POLL_INTERVAL_MINUTES=30
SEED_QUIETLY=true
HEADLESS=true
DATA_DIR=/app/data
LOG_LEVEL=INFO

