# Galim Pro / Ministry of Education credentials
GALIM_USERNAME=
GALIM_PASSWORD=

# Home Assistant's MQTT broker (Mosquitto)
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Schedule (local clock times in the configured timezone)
TZ=Asia/Jerusalem
SCHEDULES=13:00,15:00,19:00

# Optional settings
SEED_QUIETLY=true
HEADLESS=true
DATA_DIR=/app/data
LOG_LEVEL=INFO
